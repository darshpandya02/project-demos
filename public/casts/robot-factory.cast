{"version": 2, "width": 110, "height": 32, "timestamp": 1790441107, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "BSDS PA3: primary-backup robot factory"}
[0.094608, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.095205, "o", "\u001b[2m# fresh clone, then build PA3 (primary-backup robot factory) from source with clang++\u001b[0m\r\n"]
[2.10376, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mwork\u001b[0m$ git clone -q https://github.com/darshpandya02/BSDS && cd BSDS/PA3/factory_src\r\n"]
[5.989646, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ make CXX=clang++\r\n"]
[6.827498, "o", "clang++ -Wall -std=c++11   -c ServerMain.cpp ServerSocket.cpp ServerStub.cpp ServerThread.cpp\r\n"]
[9.47035, "o", "\u001b[1mServerThread.cpp:309:13: \u001b[0m\u001b[0;1;35mwarning: \u001b[0m\u001b[1mvariable 'successful_replications' set "]
[9.470485, "o", "but not used\r\n      [-Wunused-but-set-variable]\u001b[0m\r\n"]
[9.470848, "o", "  309 |       "]
[9.470918, "o", "  \u001b[0;34mint\u001b[0m successful_replications = \u001b[0;32m0\u001b[0m;\u001b[0m\r\n      | \u001b[0;1;32m            ^\r\n\u001b[0m"]
[9.771455, "o", "1 warning generated.\r\n"]
[9.776973, "o", "clang++ -Wall -std=c++11   -c Messages.cpp Socket.cpp\r\n"]
[11.478714, "o", "clang++ -Wall -std=c++11   -c ClientMain.cpp ClientSocket.cpp ClientStub.cpp ClientThread.cpp ClientTimer.cpp\r\n"]
[15.159, "o", "clang++ -pthread  -o server ServerMain.o ServerSocket.o ServerStub.o ServerThread.o Messages.o Socket.o ClientSocket.o\r\n"]
[15.392383, "o", "clang++ -pthread  -o client ClientMain.o ClientSocket.o ClientStub.o ClientThread.o ClientTimer.o Messages.o Socket.o \r\n"]
[17.4751, "o", "\u001b[2m# usage: server [port] [unique ID] [# peers] (repeat [ID] [IP] [port])\u001b[0m\r\n"]
[19.490861, "o", "\u001b[2m# three factories, each told about the other two; logs go to files\u001b[0m\r\n"]
[21.497828, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./server 12000 0 2 1 127.0.0.1 12001 2 127.0.0.1 12002 > f0.log 2>&1 &\r\n"]
[24.320198, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./server 12001 1 2 0 127.0.0.1 12000 2 127.0.0.1 12002 > f1.log 2>&1 &\r\n"]
[27.142126, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./server 12002 2 2 0 127.0.0.1 12000 1 127.0.0.1 12001 > f2.log 2>&1 & disown -a; sleep 0.5\r\n"]
[30.473096, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ lsof -nP -iTCP -sTCP:LISTEN | grep -E \"COMMAND|server\"\r\n"]
[31.37274, "o", "COMMAND     PID  USER   FD   TYPE             DEVICE SIZE/OFF NODE NAME\r\n"]
[31.372867, "o", "server     6814 darsh    3u  IPv4 0xb0d2efa6d2cb51f6      0t0  TCP *:12000 (LISTEN)\r\nserver     6823 darsh    3u  IPv4 0xffab25095e84d5f6      0t0  TCP *:12001 (LISTEN)\r\nserver     6841 darsh    3u  IPv4 0x6bcf1a50933b92e1      0t0  TCP *:12002 (LISTEN)\r\n"]
[33.385566, "o", "\u001b[2m# usage: client [ip] [port] [# customers] [# orders] [request type]\u001b[0m\r\n"]
[35.393121, "o", "\u001b[2m# type 1 = robot orders (writes). The factory that receives orders becomes the primary\u001b[0m\r\n"]
[37.400159, "o", "\u001b[2m# and replicates every order to the backups before it ships the robot.\u001b[0m\r\n"]
[39.413749, "o", "\u001b[2m# latencies are in microseconds, throughput in requests per second\u001b[0m\r\n"]
[41.423455, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12000 8 2000 1\r\n"]
[44.489168, "o", "avg latency: 976.582\tmin latency: 398.333\tmax latency: 9277.833\tthroughput: 8185.241\r\n"]
[46.501412, "o", "\u001b[2m# type 2 = customer record reads (8 customers x 2000 reads; tail keeps only the stats line)\u001b[0m\r\n"]
[48.511884, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12000 8 2000 2 | tail -n 1\r\n"]
[49.542882, "o", "avg latency: 93.991\tmin latency: 26.125\tmax latency: 2040.792\tthroughput: 74817.967\r\n"]
[51.553871, "o", "\u001b[2m# type 3 = dump customer records. Asking backup 12001 shows the replicated copy\u001b[0m\r\n"]
[53.565939, "o", "\u001b[2m# (customer id, last order number). Backups apply an entry once the next message commits it.\u001b[0m\r\n"]
[55.572918, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12001 1 7 3\r\n"]
[56.38974, "o", "0\t1999\r\n"]
[56.389871, "o", "1\t1999\r\n2\t1999\r\n"]
[56.389966, "o", "3\t1999\r\n4\t1998\r\n5\t1999\r\n"]
[56.390028, "o", "6\t1999\r\n7\t1999\r\n"]
[58.402975, "o", "\u001b[2m# kill backup 12002 while the primary keeps taking orders\u001b[0m\r\n"]
[60.412043, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ kill -9 $(lsof -t -iTCP:12002 -sTCP:LISTEN)\r\n"]
[63.320665, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12000 4 500 1\r\n"]
[64.390368, "o", "avg latency: 499.532\tmin latency: 237.500\tmax latency: 9987.709\tthroughput: 7988.618\r\n"]
[66.404642, "o", "\u001b[2m# restart it empty: on the next order the primary reconnects and replays its committed log\u001b[0m\r\n"]
[68.416558, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./server 12002 2 2 0 127.0.0.1 12000 1 127.0.0.1 12001 > f2.log 2>&1 & disown; sleep 0.5\r\n"]
[71.753836, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12000 1 3 1\r\n"]
[74.37516, "o", "avg latency: 600803.736\tmin latency: 226.458\tmax latency: 1801950.792\tthroughput: 1.664\r\n"]
[76.397417, "o", "\u001b[2m# (the large max latency is the first order waiting while the primary replays its log to 12002)\u001b[0m\r\n"]
[78.419652, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12002 1 7 3\r\n"]
[79.238027, "o", "0\t1\r\n"]
[79.238068, "o", "1\t499\r\n"]
[79.238227, "o", "2\t499\r\n3\t499\r\n4\t1999\r\n"]
[79.238319, "o", "5\t1999\r\n6\t1999\r\n7\t1999\r\n"]
[81.248613, "o", "\u001b[2m# now kill the primary 12000 and send orders to backup 12001 instead\u001b[0m\r\n"]
[83.254786, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ kill -9 $(lsof -t -iTCP:12000 -sTCP:LISTEN)\r\n"]
[86.174509, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12001 4 500 1\r\n"]
[87.397764, "o", "avg latency: 812.281\tmin latency: 129.125\tmax latency: 17270.791\tthroughput: 4899.003\r\n"]
[89.411429, "o", "\u001b[2m# 12001 took over as primary and replicates to 12002 (12000 is unreachable and skipped)\u001b[0m\r\n"]
[91.425818, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12001 1 7 3\r\n"]
[92.245517, "o", "0\t499\r\n"]
[92.245632, "o", "1\t499\r\n"]
[92.245763, "o", "2\t499\r\n"]
[92.245888, "o", "3\t499\r\n4\t1999\r\n5\t1999\r\n6\t1999\r\n"]
[92.245961, "o", "7\t1999\r\n"]
[94.257339, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ ./client 127.0.0.1 12002 1 7 3\r\n"]
[95.074557, "o", "0\t499\r\n"]
[95.074608, "o", "1\t499\r\n2\t499\r\n"]
[95.074724, "o", "3\t498\r\n4\t1999\r\n"]
[95.074814, "o", "5\t1999\r\n6\t1999\r\n"]
[95.074873, "o", "7\t1999\r\n"]
[97.089027, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mfactory_src\u001b[0m$ pkill -f \"./server 1200\"\r\n"]
