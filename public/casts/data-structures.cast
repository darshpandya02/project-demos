[53.662926, "o", "\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0m\u001b[0;33m===============================================================================\r\n\u001b[0;36m[doctest] \u001b[0mtest cases:     64 | \u001b[0;32m    64 passed\u001b[0m | \u001b[0m0 failed\u001b[0m | \u001b[0m0 skipped\u001b[0m\r\n\u001b[0;36m[doctest] \u001b[0massertions: 978254 | \u001b[0;32m978254 passed\u001b[0m | \u001b[0m0 failed\u001b[0m |\r\n\u001b[0;36m[doctest] \u001b[0mStatus: \u001b[0;32mSUCCESS!\u001b[0m\r\n"]
[55.672848, "o", "\u001b[2m# the same tests under AddressSanitizer + UndefinedBehaviorSanitizer, then ThreadSanitizer\u001b[0m\r\n"]
[57.681555, "o", "\u001b[2m# (tail keeps doctest's summary; the build lines are hidden)\u001b[0m\r\n"]
