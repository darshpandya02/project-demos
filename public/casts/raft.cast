[27.029844, "o", "\u001b[2m# boot a 5-node cluster: every node is its own raftd process, talking TCP\u001b[0m\r\n"]
[29.039375, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mraft-cluster-monitor\u001b[0m$ export RAFT_CLUSTER=127.0.0.1:7200,127.0.0.1:7201,127.0.0.1:7202,127.0.0.1:7203,127.0.0.1:7204\r\n"]
[31.860056, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mraft-cluster-monitor\u001b[0m$ for i in 0 1 2 3 4; do build/raftd --id $i --peers $RAFT_CLUSTER --data .run/demo/n$i 2>.run/demo/n$i.log & done; disown -a; sleep 1\r\n"]
