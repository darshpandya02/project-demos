[53.173414, "o", " provider=Postgres requests=50 ok=33 rejected=17 titles=[Insufficient stock:17] issued=87 transferred=12 erLeft=1 icu=12 retries=106 maxAttempts=8\r\n"]
[53.19411, "o", "\u001b[?1h\u001b="]
[55.228244, "o", "\u001b[2m# control experiment: the same race through the services, with and without the concurrency token\u001b[0m\r\n"]
[57.235246, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mmeditrack\u001b[0m$ dotnet run -c Release --no-build --project bench/MediTrack.Benchmarks -- race\r\n"]
