[40.090133, "o", "\r\nTest summary: total: 105, failed: 0, \u001b[32;1msucceeded: 105\u001b[m, skipped: 0, duration: 16.0s\r\nBuild \u001b[32;1msucceeded\u001b[m in 16.5s\r\n"]
[42.120269, "o", "\u001b[2m# the concurrency test: 50 simultaneous issues and transfers, 150 units asked for, 100 on hand\u001b[0m\r\n"]
[44.12757, "o", "\u001b[32mdarsh@mac\u001b[0m:\u001b[34mmeditrack\u001b[0m$ dotnet test tests/MediTrack.IntegrationTests -c Release --no-build --nologo --filter \"FullyQualifiedName~Parallel_issues\" --logger \"console;verbosity=detailed\" | grep -E \"provider=|Passed \"\r\n"]
[45.09106, "o", "\u001b[?1h\u001b="]
[45.944408, "o", "\u001b[?1h\u001b="]
[53.126767, "o", "\u001b[?1h\u001b="]
